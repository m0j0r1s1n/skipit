{
	"name": "skipit",
	"main": "index.js",
	"compatibility_date": "2026-07-25",
	"vars": {
		"MAINTENANCE_MODE": "false"
	},
	"assets": {
		"directory": "./",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"secrets": {
		"required": [
			"ADMIN_PASSWORD",
			"SESSION_SECRET"
		]
	},
	"ratelimits": [
		{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "FORM_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
	],
	"d1_databases": [
		{
			"binding": "skipit_db",
			"database_name": "skipit-db",
			"database_id": "bff458b4-b072-4e6c-b1ff-5f2afc4231e5",
			"remote": true
		}
	]
}

